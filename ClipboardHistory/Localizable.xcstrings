      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano değişiklikleri kaydedilemedi. Yeniden deneyebilmeniz veya etkilenen öğeleri kaldırabilmeniz için çıkış iptal edildi."
          }
        }
      }
