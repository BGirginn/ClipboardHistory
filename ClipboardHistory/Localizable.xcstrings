      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik Doğrula ve Kilidi Aç"
          }
        }
      }
    },
    "Authenticate to access this sensitive clipboard item": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hassas pano öğesine erişmek için kimliğinizi doğrulayın"
