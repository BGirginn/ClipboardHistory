    },
    "Allowed applications override exclusions. Excluded clipboard content is never read or stored.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verilen uygulamalar dışlamaları geçersiz kılar. Dışlanan pano içeriği hiçbir zaman okunmaz veya saklanmaz."
          }
        }
      }
    },
