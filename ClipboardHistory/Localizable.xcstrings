    "A clipboard item change could not be saved.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano öğesindeki değişiklik kaydedilemedi."
          }
        }
      }
    },
    "A database value could not be bound.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veritabanı değeri bağlanamadı."
          }
        }
      }
    },
    "A managed asset filename is unsafe.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetilen varlık dosya adı güvenli değil."
          }
        }
      }
    },
    "A password is required for this encrypted archive.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şifreli arşiv için parola gerekiyor."
          }
        }
      }
    },
    "Accessibility permission is required only for Paste to Active App. The item was copied; grant access in System Settings and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni yalnız Etkin Uygulamaya Yapıştır için gereklidir. Öğe kopyalandı; Sistem Ayarları'ndan izin verip yeniden deneyin."
          }
        }
      }
    },
    "Accessibility permission is required to block keyboard input.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye girişini engellemek için Erişilebilirlik izni gerekir."
          }
        }
      }
    },
    "Accessibility permission is required to reverse scrolling.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırmayı ters çevirmek için Erişilebilirlik izni gerekir."
          }
        }
      }
    },
