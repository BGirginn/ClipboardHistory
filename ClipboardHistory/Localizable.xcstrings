      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Dakika Sonra"
          }
        }
      }
    },
    "After 15 Minutes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Dakika Sonra"
          }
        }
      }
    },
    "After 5 Minutes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Dakika Sonra"
          }
        }
      }
    },
    "After preparing the files, open Brave, Chrome, Edge, or Arc Extensions, enable Developer Mode, choose Load unpacked, and select the revealed folder.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar hazırlandıktan sonra Brave, Chrome, Edge veya Arc Eklentiler sayfasını açın, Geliştirici Modunu etkinleştirin, Paketlenmemiş öğe yükle seçeneğini kullanın ve gösterilen klasörü seçin."
          }
        }
      }
    },
    "All": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümü"
          }
        }
      }
    },
    "All physical interfaces": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm fiziksel arabirimler"
          }
        }
