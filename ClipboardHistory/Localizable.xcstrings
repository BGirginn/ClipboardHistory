    "Audio is processed in memory only. ClipboardHistory never records, stores, analyzes, or logs audio samples.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yalnızca bellekte işlenir. ClipboardHistory ses örneklerini kaydetmez, depolamaz, analiz etmez veya günlüğe yazmaz."
          }
        }
      }
    },
