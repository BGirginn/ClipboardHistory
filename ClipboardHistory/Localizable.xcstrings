{
  "sourceLanguage": "en",
  "strings": {
    " — right-click for options": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " — seçenekler için sağ tıklayın"
          }
        }
      }
    },
    "%arg %arg": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$arg %2$arg"
          }
        }
      }
    },
    "%arg audio apps · %arg controlled tabs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$arg ses uygulaması · %2$arg denetlenen sekme"
